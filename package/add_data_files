#!/bin/bash

set -e

project_file=Squirrel.xcodeproj/project.pbxproj
test -f "${project_file}"

# Anchor must reference a real entry in project.pbxproj. Upstream's
# terra_pinyin/librime-lua anchors do NOT exist in smoodle-app's pbxproj
# (terra_pinyin schema was never added; rime-plugins build phase exists
# but no plugin file refs were ever wired). With a missing anchor, awk
# in add_line() matches nothing → tmp file is byte-identical → mv is a
# no-op → "adding X" log message lies. v0.0.8a shipped without
# default.custom.yaml because of this. Use thai_phonetic.dict.yaml as
# anchor — it is the latest data/plum entry committed to pbxproj
# (441E638322B7E96F006DCCDD + 441E638422B7E90C006DCCDD).
anchor=(83 84 thai_phonetic.dict.yaml)
anchor_lib=()  # no working anchor; smoodle does not bundle rime plugins (yet)

# next free 441E63XX id after 83..88 (vendored schema + default.custom.yaml) and
# 89..94 (data/smoodle: extended dict, schema patch, user dict template —
# wired by hand in pbxproj, see action-build.sh).
lastid=94

require_anchor_present() {
    local file="$1"
    if ! grep -Fq "/* ${file} in Copy Shared Support Files */" "${project_file}"; then
        echo "FATAL: anchor file '${file}' missing from ${project_file}" >&2
        echo "  add_data_files would silently no-op every insert." >&2
        echo "  Update anchor=(...) in $(basename "$0") to an existing entry." >&2
        exit 1
    fi
}
require_anchor_present "${anchor[2]}"

obj_entry() {
    local id=$1
    local ref=$2
    local file="$3"
    echo "441E63${id}22B7E96F006DCCDD /* ${file} in Copy Shared Support Files */ = {isa = PBXBuildFile; fileRef = 441E63${ref}22B7E90C006DCCDD /* ${file} */; };"
}

copy_files_entry() {
    local id=$1
    local ref=$2
    local file="$3"
    echo "441E63${id}22B7E96F006DCCDD /* ${file} in Copy Shared Support Files */,"
}

file_ref_entry() {
    local id=$1
    local ref=$2
    local file="$3"
    echo "441E63${ref}22B7E90C006DCCDD /* ${file} */ = {isa = PBXFileReference; fileEncoding = 4; lastKnownFileType = text; name = ${file}; path = data/plum/${file}; sourceTree = \"<group>\"; };"
}

group_entry() {
    local id=$1
    local ref=$2
    local file="$3"
    echo "441E63${ref}22B7E90C006DCCDD /* ${file} */,"
}

lib_entry() {
    local id=$1
    local ref=$2
    local lib="$3"
    echo "2C6B9F${id}2BCD086700E327DF /* ${lib} in Copy Rime plugins */ = {isa = PBXBuildFile; fileRef = 2C6B9F${ref}2BCD086700E327DF /* ${lib} */; settings = {ATTRIBUTES = (CodeSignOnCopy, ); }; };"
}

lib_ref_entry() {
    local id=$1
    local ref=$2
    local lib="$3"
    echo "2C6B9F${ref}2BCD086700E327DF /* ${lib} */ = {isa = PBXFileReference; lastKnownFileType = \"compiled.mach-o.dylib\"; name = \"${lib}\"; path = \"lib/rime-plugins/${lib}\"; sourceTree = \"<group>\"; };"
}

frameworks_phase_entry() {
    local id=$1
    local ref=$2
    local lib="$3"
    echo "2C6B9F${id}2BCD086700E327DF /* ${lib} in Copy Rime plugins */,"
}

add_line() {
    # macOS BSD sed -i '' + multi-line `a\` always exits 2 (spurious
    # "can't read :" error) on current macOS even when the insert
    # succeeds. Use awk instead — portable across BSD/GNU and exits
    # cleanly.
    local pattern="^[[:space:]]*$(sed 's/\*/\\*/g' <<< "${1}")\$"
    local newline="${2}"
    awk -v pat="${pattern}" -v line="${newline}" '
        $0 ~ pat { print; print line; next }
        { print }
    ' "${project_file}" > "${project_file}.tmp" && mv -f "${project_file}.tmp" "${project_file}"
}

add_file() {
    local file="$1"
    local new_id=$(( ++lastid ))
    local new_refid=$(( ++lastid ))
    local anchor_line
    local new_line

    anchor_line="$(obj_entry ${anchor[@]})"
    new_line="$(obj_entry ${new_id} ${new_refid} "${file}")"
    add_line "${anchor_line}" "${new_line}"

    anchor_line="$(copy_files_entry ${anchor[@]})"
    new_line="$(copy_files_entry ${new_id} ${new_refid} "${file}")"
    add_line "${anchor_line}" "${new_line}"

    anchor_line="$(file_ref_entry ${anchor[@]})"
    new_line="$(file_ref_entry ${new_id} ${new_refid} "${file}")"
    add_line "${anchor_line}" "${new_line}"

    anchor_line="$(group_entry ${anchor[@]})"
    new_line="$(group_entry ${new_id} ${new_refid} "${file}")"
    add_line "${anchor_line}" "${new_line}"
}

add_lib() {
    local lib="$1"
    local new_lib_id=$(( ++lastid ))
    local new_lib_refid=$(( ++lastid ))
    local anchor_line
    local new_line

    # Assuming you have similar 'anchor' values for library entries
    anchor_lib_line="$(lib_entry ${anchor_lib[@]})"
    new_lib_line="$(lib_entry ${new_lib_id} ${new_lib_refid} "${lib}")"
    add_line "${anchor_lib_line}" "${new_lib_line}"

    anchor_lib_line="$(lib_ref_entry ${anchor_lib[@]})"
    new_lib_line="$(lib_ref_entry ${new_lib_id} ${new_lib_refid} "${lib}")"
    add_line "${anchor_lib_line}" "${new_lib_line}"

    anchor_lib_line="$(frameworks_phase_entry ${anchor_lib[@]})"
    new_lib_line="$(frameworks_phase_entry ${new_lib_id} ${new_lib_refid} "${lib}")"
    add_line "${anchor_lib_line}" "${new_lib_line}"
}


data_files=(
    $(ls data/plum/* | xargs basename)
)

lib_files=(
    $(ls lib/rime-plugins/* | xargs basename)
)

for file in "${data_files[@]}"
do
    if grep -Fq " ${file} " "${project_file}"
    then
	echo "found ${file}"
	continue
    fi
    echo "adding ${file} to ${project_file}"
    add_file "${file}"
done

if [ "${#anchor_lib[@]}" -eq 3 ]; then
    for lib in "${lib_files[@]}"
    do
        if grep -Fq " ${lib} " "${project_file}"
        then
            echo "found ${lib}"
            continue
        fi
        echo "adding ${lib} to ${project_file}"
        add_lib "${lib}"
    done
else
    echo "skip lib wiring (anchor_lib disabled — no plugins shipped)"
fi
